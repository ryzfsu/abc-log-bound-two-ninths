module

public import Mathlib

/-!
# Rect Basis

The module represents a rank-two lattice by integer coordinates and constructs reduced columns with controlled weighted mass.

## Main results
* `AbcTwoNinths.Basic.reducedColumns`
* `AbcTwoNinths.Basic.weightedBasis`
-/

@[expose] public section


namespace AbcTwoNinths.Basic

section

/-- The z pair. -/
abbrev ZPair := ℤ × ℤ

/-- The eval. -/
def eval {I : Type*} (e v : I → ℤ) (x : _root_.AbcTwoNinths.Basic.ZPair) (i : I) : ℤ :=
  x.1 * e i + x.2 * v i

/-- The det. -/
def det (x y : _root_.AbcTwoNinths.Basic.ZPair) : ℤ := x.1 * y.2 - x.2 * y.1

/-- The shear. -/
def shear (n : ℤ) (x y : _root_.AbcTwoNinths.Basic.ZPair) : _root_.AbcTwoNinths.Basic.ZPair := (n*x.1+y.1, n*x.2+y.2)

/-- The mass. -/
noncomputable def mass {I : Type*} [Fintype I] (w : I → ℝ) (f : I → ℤ) : ℝ :=
  ∑ i, |(f i : ℝ)| * w i

/-- Two rationally independent exponent vectors give distinct evaluations for distinct
integral coordinate pairs. -/
theorem evalInjective {I : Type*} {e v : I → ℤ} {j : I} (hj : e j ≠ 0)
    (hind : ¬ ∃ r : ℚ, ∀ i, (v i : ℚ) = r * (e i : ℚ)) :
    Function.Injective (_root_.AbcTwoNinths.Basic.eval e v) := by
  intro x y h
  have heq (i : I) : (x.1-y.1)*e i + (x.2-y.2)*v i = 0 := by
    have hi := congrFun h i
    unfold _root_.AbcTwoNinths.Basic.eval at hi
    linarith
  by_cases hb : x.2 = y.2
  · have h₁ := heq j
    rw [hb, sub_self, zero_mul, add_zero] at h₁
    exact Prod.ext (sub_eq_zero.mp ((mul_eq_zero.mp h₁).resolve_right hj)) hb
  · exfalso
    apply hind
    refine ⟨-((x.1:ℚ)-y.1)/((x.2:ℚ)-y.2), fun i => ?_⟩
    have hn : (x.2 : ℚ) - y.2 ≠ 0 := by exact_mod_cast sub_ne_zero.mpr hb
    have hi : ((x.1:ℚ)-y.1)*e i + ((x.2:ℚ)-y.2)*v i = 0 := by
      exact_mod_cast heq i
    field_simp
    linarith

/-- Only finitely many integer vectors have weighted absolute mass at most `C` when every
coordinate weight is positive. -/
theorem finiteMassLe {I : Type*} [Fintype I] {w : I → ℝ}
    (hw : ∀ i, 0 < w i) (C : ℝ) :
    {f : I → ℤ | _root_.AbcTwoNinths.Basic.mass w f ≤ C}.Finite := by
  classical
  let N (i : I) : ℤ := ⌈C / w i⌉
  have hbox : (Set.pi Set.univ (fun i => Set.Icc (-N i) (N i))).Finite :=
    Set.Finite.pi fun _ => Set.finite_Icc _ _
  apply hbox.subset
  intro f hf i _
  have hsum : |(f i:ℝ)| * w i ≤ _root_.AbcTwoNinths.Basic.mass w f :=
    Finset.single_le_sum (fun j _ => mul_nonneg (abs_nonneg ((f j):ℝ)) (hw j).le)
      (Finset.mem_univ i)
  have hr : |(f i:ℝ)| ≤ N i :=
    ((le_div_iff₀ (hw i)).mpr (hsum.trans hf)).trans (Int.le_ceil _)
  have hz : |f i| ≤ N i := by exact_mod_cast hr
  exact abs_le.mp hz

/--
Minimize over extendable first columns, then over their complements.
No saturation of the ambient exponent lattice is used.
-/
theorem reducedColumns (F : _root_.AbcTwoNinths.Basic.ZPair → ℝ) (hF : Northcott F) :
    ∃ x y : _root_.AbcTwoNinths.Basic.ZPair, _root_.AbcTwoNinths.Basic.det x y = 1 ∧ F x ≤ F y ∧
      ∀ n : ℤ, F y ≤ F (_root_.AbcTwoNinths.Basic.shear n x y) := by
  let U := {x : _root_.AbcTwoNinths.Basic.ZPair | ∃ y : _root_.AbcTwoNinths.Basic.ZPair, _root_.AbcTwoNinths.Basic.det x y = 1}
  have hU : U.Nonempty := ⟨(1,0), (0,1), by decide⟩
  obtain ⟨x, hx, hmin⟩ := Northcott.exists_min_image F U hU
  obtain ⟨y₀, hy₀⟩ := hx
  obtain ⟨y, hy, hopt⟩ := Northcott.exists_min_image F
    {y : _root_.AbcTwoNinths.Basic.ZPair | _root_.AbcTwoNinths.Basic.det x y = 1} ⟨y₀, hy₀⟩
  change _root_.AbcTwoNinths.Basic.det x y = 1 at hy
  refine ⟨x,y,hy,hmin y ⟨(-x.1,-x.2), ?_⟩, fun n => hopt _ ?_⟩
  · unfold _root_.AbcTwoNinths.Basic.det at hy ⊢
    dsimp
    linarith
  · change _root_.AbcTwoNinths.Basic.det x (_root_.AbcTwoNinths.Basic.shear n x y) = 1
    unfold _root_.AbcTwoNinths.Basic.det _root_.AbcTwoNinths.Basic.shear at *
    dsimp
    linear_combination hy

/--
The nonzero B2 pivot and rational independence suffice to construct
the weighted reduced basis in the plane generated by the collision.
-/
theorem weightedBasis {I : Type*} [Fintype I] {e v : I → ℤ}
    {j : I} (hj : e j ≠ 0)
    (hind : ¬ ∃ r : ℚ, ∀ i, (v i : ℚ) = r * (e i : ℚ))
    {w : I → ℝ} (hw : ∀ i, 0 < w i) :
    ∃ x y : _root_.AbcTwoNinths.Basic.ZPair, _root_.AbcTwoNinths.Basic.det x y = 1 ∧ _root_.AbcTwoNinths.Basic.mass w (_root_.AbcTwoNinths.Basic.eval e v x) ≤ _root_.AbcTwoNinths.Basic.mass w (_root_.AbcTwoNinths.Basic.eval e v y) ∧
      ∀ n : ℤ, _root_.AbcTwoNinths.Basic.mass w (_root_.AbcTwoNinths.Basic.eval e v y) ≤ _root_.AbcTwoNinths.Basic.mass w (_root_.AbcTwoNinths.Basic.eval e v (_root_.AbcTwoNinths.Basic.shear n x y)) := by
  apply _root_.AbcTwoNinths.Basic.reducedColumns (fun x => _root_.AbcTwoNinths.Basic.mass w (_root_.AbcTwoNinths.Basic.eval e v x))
  exact ⟨fun C => (_root_.AbcTwoNinths.Basic.finiteMassLe hw C).preimage (_root_.AbcTwoNinths.Basic.evalInjective hj hind).injOn⟩

end

end AbcTwoNinths.Basic
