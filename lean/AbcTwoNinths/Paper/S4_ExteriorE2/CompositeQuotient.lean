module

public import AbcTwoNinths.Paper.S4_ExteriorE2.ResidueQuotientRing

/-!
# Composite Quotient

The module defines reduction modulo a composite ideal and characterizes equality in the quotient. It supports Proposition 4.1 of the paper.

## Main results
* `AbcTwoNinths.ExteriorE2.compositeReduceMk`
-/

@[expose] public section


namespace AbcTwoNinths.ExteriorE2

section

/--
The ideal generated by a power of the modulus in the subring of rationals with denominator coprime to that modulus. This is used in the proof of Proposition 4.1 of the paper.
-/
def compositeIdeal (B E : ℕ) : Ideal (_root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) :=
  Ideal.span {(B : _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) ^ E}

/--
Two quotient classes coincide exactly when the modulus power divides the numerator of their difference.
-/
theorem compositeQuotientEqIff {B E : ℕ} (a b : _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) :
    Ideal.Quotient.mk (_root_.AbcTwoNinths.ExteriorE2.compositeIdeal B E) a =
      Ideal.Quotient.mk (_root_.AbcTwoNinths.ExteriorE2.compositeIdeal B E) b ↔
        (B : ℤ) ^ E ∣ (a - b).val.num := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, _root_.AbcTwoNinths.ExteriorE2.compositeIdeal, Ideal.mem_span_singleton]
  exact ⟨_root_.AbcTwoNinths.ExteriorE2.compositeNumOfDvd _, _root_.AbcTwoNinths.ExteriorE2.compositeDvdOfNum _⟩

/--
Reduction from a positive power of the modulus to its first power. This is used in the proof of Proposition 4.1 of the paper.
-/
def compositeReduce (B E : ℕ) (hE : 0 < E) :
    _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B ⧸ _root_.AbcTwoNinths.ExteriorE2.compositeIdeal B E →+*
      _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B ⧸ _root_.AbcTwoNinths.ExteriorE2.compositeIdeal B 1 := by
  apply Ideal.Quotient.lift _ (Ideal.Quotient.mk (_root_.AbcTwoNinths.ExteriorE2.compositeIdeal B 1))
  intro a ha
  apply (Ideal.Quotient.eq_zero_iff_mem).2
  have hh : _root_.AbcTwoNinths.ExteriorE2.compositeIdeal B E ≤ _root_.AbcTwoNinths.ExteriorE2.compositeIdeal B 1 := by
    rw [_root_.AbcTwoNinths.ExteriorE2.compositeIdeal, Ideal.span_le, Set.singleton_subset_iff]
    change (B : _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) ^ E ∈ Ideal.span { (B : _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) ^ 1 }
    rw [Ideal.mem_span_singleton, pow_one]
    exact dvd_pow_self _ (Nat.ne_of_gt hE)
  exact hh ha

/--
Reducing a quotient class gives the class of the same representative modulo the modulus. This is used in the proof of Proposition 4.1 of the paper.
-/
@[simp] theorem compositeReduceMk (B E : ℕ) (hE : 0 < E) (x : _root_.AbcTwoNinths.ExteriorE2.SubringCoprime B) :
    _root_.AbcTwoNinths.ExteriorE2.compositeReduce B E hE (Ideal.Quotient.mk (_root_.AbcTwoNinths.ExteriorE2.compositeIdeal B E) x) =
      Ideal.Quotient.mk (_root_.AbcTwoNinths.ExteriorE2.compositeIdeal B 1) x := rfl

end

end AbcTwoNinths.ExteriorE2
